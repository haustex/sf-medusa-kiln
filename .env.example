# Medusa backend (public URL for the browser; the server may use an internal one)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://127.0.0.1:9710
MEDUSA_BACKEND_URL_INTERNAL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
# Public origin of the storefront (canonical URLs, JSON-LD, OpenGraph)
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:9720
# Optional: public origin that serves product images (e.g. Cloudflare R2 through medusa-storage-r2)
NEXT_PUBLIC_MEDIA_URL=
# Optional: Meilisearch (search + PLP facets); without it the store search uses Medusa's /store/products?q=
MEILISEARCH_HOST=
MEILISEARCH_SEARCH_KEY=
# Stripe publishable key (pk_test_… / pk_live_…): card payments at checkout. The backend needs STRIPE_API_KEY
# (secret key) and the provider enabled on the region; without a key only the dev "Pay later" provider shows.
NEXT_PUBLIC_STRIPE_KEY=
# medusa-payment-manual-transfer: the storefront relays proof uploads with the buyer's IP; this must equal the
# plugin's trustedProxySecret (MANUAL_TRANSFER_PROXY_SECRET in the backend). Server-only, never NEXT_PUBLIC_.
MANUAL_TRANSFER_PROXY_SECRET=
# medusa-payment-doit: "true" sends the buyer to doit.id's hosted page instead of showing the QR / VA in checkout
NEXT_PUBLIC_DOIT_REDIRECT_TO_HOSTED=
# medusa-fulfillment-zone-rate: the storefront relays tracking lookups with the buyer's IP; this must equal the
# plugin's tracking.trustedProxySecret. Server-only.
ZONE_RATE_PROXY_SECRET=
# Shared secret for POST /api/revalidate (cache purge from the backend)
REVALIDATE_SECRET=
# "true" opens the site to search engines (robots, sitemap, X-Robots-Tag); anything else keeps it noindex
SITE_LIVE=false

# Optional integrations are detected from the backend at start (reviews, wishlist, blog, Meilisearch route,
# zone-rate shipping): a 404 switches the feature off. Force one with on/off, e.g. KILN_FEATURE_BLOG=off
# (see src/lib/features.ts)
KILN_FEATURE_REVIEWS=
KILN_FEATURE_WISHLIST=
KILN_FEATURE_BLOG=
KILN_FEATURE_SEARCH=
KILN_FEATURE_TRACKING=

# Demo deployments: a one-line "demo store" notice above the header (true/false)
# KILN_DEMO_NOTICE=false
